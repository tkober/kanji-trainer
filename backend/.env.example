# Copy to backend/.env for local development. The deployment passes the same
# variables through compose's env_file instead.

# --- WaniKani -------------------------------------------------------------
# A read-only personal access token from wanikani.com → Settings → API Tokens.
# Only used by the import; nothing here ever writes back to WaniKani. Can also
# be set in the Settings screen, which stores it in the database and takes
# precedence over this value.
WANIKANI_API_TOKEN=
WANIKANI_API_BASE=https://api.wanikani.com/v2
# SRS stage 5 is "Guru I". Everything at or above it is imported as already
# known — the setting that decides how much of your WaniKani history you keep.
WANIKANI_KNOWN_SRS_STAGE=5

# --- SRS ------------------------------------------------------------------
# Hours until the review that enters each stage. Index 0 and 9 are 0 because
# nothing is scheduled there. Defaults match WaniKani.
SRS_INTERVAL_HOURS=0,4,8,24,48,168,336,720,2880,0
# Where "das kann ich" parks an item. 9 retires it, 8 leaves one check-up.
KNOWN_SRS_STAGE=9
REVIEW_GRACE_MINUTES=59

# --- Database -------------------------------------------------------------
# Postgres: DB_URL carries only host/port/database, credentials come per role.
DB_URL=postgresql://localhost:5432/kanji_trainer
DB_USER=kanji_trainer_app
DB_PASSWORD=
DB_OWNER_USER=kanji_trainer_owner
DB_OWNER_PASSWORD=
#
# Or point it at a file instead, for a machine with no Postgres. The roles are
# ignored then — SQLite's access control is the filesystem's.
# DB_URL=sqlite:///./kanji_trainer.db

# --- Server ---------------------------------------------------------------
# Only needed for `ng serve`; the deployment is same-origin behind nginx.
CORS_ORIGINS=http://localhost:4200
