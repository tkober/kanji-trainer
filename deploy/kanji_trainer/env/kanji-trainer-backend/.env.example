# Copy to .env next to this file and fill in the two passwords. They have to
# match what create_users_and_db.sql was run with.
#
# Note: write the passwords WITHOUT surrounding quotes. Docker Compose strips
# those before the container sees the value, so a role created with them can
# never be logged into.

# postgres-core lives in its own stack and is reached by container name over
# the external postgres-core-net.
DB_URL=postgresql://postgres-core:5432/kanji_trainer
DB_USER=kanji_trainer_app
DB_PASSWORD=
DB_OWNER_USER=kanji_trainer_owner
DB_OWNER_PASSWORD=

# Read-only WaniKani token. Optional here — the Settings screen stores one in
# the database and that takes precedence. Setting it here means a fresh
# deployment can import without visiting the screen first; the UI then says
# the token comes from the environment and cannot be cleared from the browser.
WANIKANI_API_TOKEN=

# The SPA is served same-origin behind this stack's nginx, so no browser
# origin ever needs allowing.
CORS_ORIGINS=
